{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kovee.example/kcp/v0/ops/invocation-create-result.schema.json",
  "title": "KCP invocation_create result (DESIGN.md §10.6)",
  "description": "CommandResult.result payload for invocation_create (§11.2 ok arm; the envelope's revision/event_cursor members live outside this payload). The created Invocation record projection (gap note KG4).",
  "$ref": "#/$defs/invocation",
  "type": "object",
  "$defs": {
    "digestHex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 value of a §11.8 typed digest; the digest type/domain is fixed by the schema field holding it (§11.8: a bare 32-byte value cannot be substituted across digest fields)."
    },
    "identifier": {
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$",
      "description": "Opaque identifier, at most 128 bytes (§11.8); visible-ASCII alphabet is a K0 extraction decision (spec/schemas/README.md)."
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "realm_id",
        "project_id",
        "assistant_deployment_id",
        "assistant_deployment_revision",
        "assistant_revision_id",
        "effective_config_ref",
        "effective_config_digest",
        "secret_binding_set_ref",
        "secret_binding_set_digest",
        "effective_policy_digest",
        "effective_security_profile",
        "rollout_decision_ref",
        "trigger_ref",
        "trigger_digest",
        "input_manifest_ref",
        "input_digest",
        "correlation_ref",
        "state",
        "revision",
        "priority",
        "not_before",
        "deadline",
        "max_attempts",
        "created_at"
      ],
      "properties": {
        "invocation_id": {
          "$ref": "#/$defs/identifier"
        },
        "realm_id": {
          "$ref": "#/$defs/identifier"
        },
        "project_id": {
          "$ref": "#/$defs/identifier"
        },
        "space_id": {
          "$ref": "#/$defs/identifier"
        },
        "branch_id": {
          "$ref": "#/$defs/identifier"
        },
        "assistant_deployment_id": {
          "$ref": "#/$defs/identifier"
        },
        "assistant_deployment_revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "assistant_revision_id": {
          "$ref": "#/$defs/identifier"
        },
        "effective_config_ref": {
          "$ref": "#/$defs/identifier"
        },
        "effective_config_digest": {
          "$ref": "#/$defs/digestHex"
        },
        "secret_binding_set_ref": {
          "$ref": "#/$defs/identifier"
        },
        "secret_binding_set_digest": {
          "$ref": "#/$defs/digestHex"
        },
        "effective_policy_digest": {
          "$ref": "#/$defs/digestHex"
        },
        "effective_security_profile": {
          "$ref": "#/$defs/securityProfile"
        },
        "rollout_decision_ref": {
          "$ref": "#/$defs/identifier"
        },
        "trigger_ref": {
          "$ref": "#/$defs/identifier"
        },
        "trigger_digest": {
          "$ref": "#/$defs/digestHex"
        },
        "context_assembly_ref": {
          "$ref": "#/$defs/identifier"
        },
        "context_assembly_digest": {
          "$ref": "#/$defs/digestHex"
        },
        "input_manifest_ref": {
          "$ref": "#/$defs/identifier"
        },
        "input_digest": {
          "$ref": "#/$defs/digestHex"
        },
        "correlation_ref": {
          "$ref": "#/$defs/identifier"
        },
        "causation_ref": {
          "$ref": "#/$defs/identifier"
        },
        "commitment_ref": {
          "$ref": "#/$defs/identifier"
        },
        "work_realization_ref": {
          "$ref": "#/$defs/identifier"
        },
        "state": {
          "$ref": "#/$defs/invocationState"
        },
        "revision": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "priority": {
          "$ref": "#/$defs/safeNonNegativeInteger",
          "description": "Scheduling priority; DESIGN.md pins no encoding — safe non-negative integer (gap note KG8)."
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "deadline": {
          "$ref": "#/$defs/timestamp"
        },
        "max_attempts": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "budget_reservation_set_ref": {
          "$ref": "#/$defs/identifier"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "terminal_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "description": "Invocation projection, field names verbatim from the §10.6 record shape (optional members exactly the record's ?-marked fields); state is the closed §10.6 machine."
    },
    "invocationState": {
      "enum": [
        "queued",
        "claimed",
        "running",
        "waiting_commitment",
        "waiting_human",
        "waiting_resource",
        "succeeded",
        "failed",
        "canceled",
        "ambiguous"
      ],
      "description": "Closed §10.6 invocation state machine."
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "I-JSON safe integer (§11.8 rejects unsafe integers)."
    },
    "securityProfile": {
      "enum": [
        "developer",
        "confined",
        "secure"
      ],
      "description": "Closed §14.4 security-profile names."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "format": "date-time",
      "description": "RFC 3339 date-time (recorded K0 extraction decision, spec/schemas/README.md item 7); format: date-time additionally requires semantic calendar validity (R0 KENV-05)."
    }
  }
}
