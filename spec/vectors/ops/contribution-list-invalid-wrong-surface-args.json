{
  "name": "ops/contribution-list-invalid-wrong-surface-args",
  "description": "wrong-surface args: hidden endpoints are non-enumerable (§10.2); a filter can never widen visibility (gap note KG9)",
  "input": {
    "schema": "contribution-list-request",
    "value": {
      "version": "0.1",
      "op": "contribution_list",
      "realm_id": "realm-0001",
      "project_id": "proj-0001",
      "args": {
        "space_id": "space-0001",
        "branch_id": "branch-0001",
        "kind": "claim",
        "limit": 100,
        "include_hidden": true
      }
    }
  },
  "expected": {
    "valid": false,
    "reason": "unknown member include_hidden"
  }
}
